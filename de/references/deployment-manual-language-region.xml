  <info>
   <title>Sprach- und Regionseinstellungen festlegen</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
        Passen Sie die Lokalisierungseinstellungen wie Sprache, Tastaturlayout und Zeitzone auf dem Bildschirm <guilabel>Sprache und Region</guilabel> an.
      </para>
    </abstract>
  </info>
  <figure xml:id="fig-deployment-manual-language-region">
    <title>&agama; Lokalisierungseinstellungen des Installers</title>
    <mediaobject>
      <textobject role="description">
        <phrase>Screenshot des &agama;-Installers für &productname; &productnumber;, der die Seite für Sprach- und Regionseinstellungen zeigt. Es bietet Dropdown-Auswahlmenüs für die Anzeigesprache, das Tastaturlayout und die Zeitzone. </phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-localization.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-localization.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-localization.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-localization.png" width="100%"/>
      </imageobject>
    </mediaobject>
  </figure>
  <variablelist>
    <title>Sprach- und Regionseinstellungen</title>
    <varlistentry>
      <term>Sprache</term>
      <listitem>
        <para>
          Die für das System verwendete Sprache. Sie kann von der während der Installation verwendeten Sprache abweichen. Standardwert: <literal>English (United States)</literal>.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Tastatur</term>
      <listitem>
        <para>
          Die für das System verwendete Tastatur. Sie kann von der während der Installation verwendeten Tastatur abweichen. Standardwert: <literal>English (US)</literal>.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Zeitzone</term>
      <listitem>
        <para>
          Die Zeitzone des Systems. Der Standardwert wird automatisch basierend auf Ihrem Netzwerkstandort ermittelt.
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
  <para>
    Klicken Sie auf <guimenu>Übernehmen</guimenu>, um Ihre Änderungen zu speichern.
  </para>
