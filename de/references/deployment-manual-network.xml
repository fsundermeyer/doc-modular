  <info>
   <title>Konfigurieren des Netzwerks</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
       Verwalten Sie Netzwerkverbindungen im Bildschirm <guilabel>Netzwerk</guilabel>.
      </para>
    </abstract>
  </info>
  <figure xml:id="fig-deployment-manual-network">
    <title>&agama; Netzwerkeinstellungen des Installationsprogramms</title>
    <mediaobject>
      <textobject role="description">
        <phrase>Screenshot des &agama;-Installationsprogramms für &productname; &productnumber;, das die Netzwerkkonfigurationsseite zeigt. Es listet aktive Netzwerkschnittstellen, IP-Adressen und Optionen zum Hinzufügen neuer kabelgebundener oder WLAN-Verbindungen auf. </phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-network.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-network.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-network.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-network.png" width="100%"/>
      </imageobject>
