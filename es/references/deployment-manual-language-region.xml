  <info>
   <title>Configuración de idioma y región</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
        Ajuste la configuración de localización, como el idioma, la distribución del teclado y la zona horaria, en la pantalla <guilabel>Idioma y región</guilabel>.
      </para>
    </abstract>
  </info>
  <figure xml:id="fig-deployment-manual-language-region">
    <title>&agama; Configuración de localización del instalador</title>
    <mediaobject>
      <textobject role="description">
        <phrase>Captura de pantalla del instalador &agama; para &productname; &productnumber; que muestra la página de configuración de idioma y región. Proporciona menús desplegables de selección para el idioma de visualización, la distribución del teclado y la zona horaria. </phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-localization.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-localization.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-localization.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-localization.png" width="100%"/>
      </imageobject>
    </mediaobject>
  </figure>
  <variablelist>
    <title>Configuración de idioma y región</title>
    <varlistentry>
      <term>Idioma</term>
      <listitem>
        <para>
          El idioma utilizado para el sistema. Puede ser diferente del idioma utilizado durante la instalación. Valor por defecto: <literal>English (United States)</literal>.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Teclado</term>
      <listitem>
        <para>
          El teclado utilizado para el sistema. Puede ser diferente del teclado utilizado durante la instalación. Valor por defecto: <literal>English (US)</literal>.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Zona horaria</term>
      <listitem>
        <para>
          La zona horaria del sistema. El valor por defecto se determina automáticamente en función de su ubicación de red.
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
  <para>
    Haga clic en <guimenu>Aceptar</guimenu> para guardar sus cambios.
  </para>
</topic>
