  <info>
   <title>Configuração de idioma e região</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
        Ajuste as configurações de localização, como idioma, layout do teclado e fuso horário, na tela <guilabel>Idioma e região</guilabel>.
      </para>
    </abstract>
  </info>
  <figure xml:id="fig-deployment-manual-language-region">
    <title>&agama; configurações de localização do instalador</title>
    <mediaobject>
      <textobject role="description">
        <phrase>Captura de tela do instalador &agama; para &productname; &productnumber; mostrando a página de configurações de idioma e região. Ele fornece menus de seleção suspensos para o idioma de exibição, layout do teclado e fuso horário. </phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-localization.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-localization.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata os="sles;sles4nvidia" fileref="agama-installation-sles-localization.png" width="100%"/>
        <imagedata os="sles4sap" fileref="agama-installation-sap-localization.png" width="100%"/>
      </imageobject>
    </mediaobject>
  </figure>
  <variablelist>
    <title>Configurações de idioma e região</title>
    <varlistentry>
      <term>Idioma</term>
      <listitem>
        <para>
          O idioma usado para o sistema. Ele pode ser diferente do idioma usado durante a instalação. Valor padrão: <literal>English (United States)</literal>.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Teclado</term>
      <listitem>
        <para>
          O teclado usado para o sistema. Ele pode ser diferente do teclado usado durante a instalação. Valor padrão: <literal>English (US)</literal>.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Fuso Horário</term>
      <listitem>
        <para>
          O fuso horário do sistema. O valor padrão é determinado automaticamente com base na localização da sua rede.
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
  <para>
    Clique em <guimenu>Aceitar</guimenu> para salvar suas alterações.
  </para>
</topic>
